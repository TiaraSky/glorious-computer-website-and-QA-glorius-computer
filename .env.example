APP_NAME="Glorious Comp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DEBUGBAR_ENABLED=true

# --- Production / Vercel (set di Vercel Dashboard > Settings > Environment Variables) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://gloriouscomp.vercel.app
# APP_KEY=                  # php artisan key:generate --show
# SESSION_DRIVER=cookie
# CACHE_DRIVER=array
# LOG_CHANNEL=stderr
# QUEUE_CONNECTION=sync

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime Vercel / Supabase transaction pooler: DB_PORT=6543
# Migrasi dari lokal: session pooler DB_PORT=5432
# Laravel PDO hanya menerima postgres:// atau postgresql:// — jangan isi prisma+postgres://
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-north-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.hlitqfshebgyejgtrrjk
DB_PASSWORD=
DB_SSLMODE=require

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP — isi salah satu provider (contoh Resend / Brevo / Gmail App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Storage (S3-compatible). Wajib isi AWS_BUCKET di Vercel atau adapter S3 akan gagal.
# FILESYSTEM_PUBLIC_DRIVER=s3
# FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://hlitqfshebgyejgtrrjk.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOGO=
# Nomor WhatsApp admin (format 62xxx, untuk redirect wa.me saat checkout)
ADMIN_WHATSAPP_NUMBER=6282133803940
# Email penerima form konsultasi gratis (dashboard)
CONSULTATION_EMAIL=gloriouscompt@gmail.com
