-- Ganti RAILWAY_* dan SUPABASE_PASSWORD secara lokal. Jangan commit file yang sudah berisi password.
-- Disarankan: php artisan migrate --force ke Supabase dulu, lalu load DATA SAJA.
--
--   pgloader scripts/pgloader-railway-to-supabase.load

LOAD DATABASE
     FROM mysql://RAILWAY_USER:RAILWAY_PASSWORD@RAILWAY_HOST:3306/RAILWAY_DB
     INTO postgresql://postgres.hlitqfshebgyejgtrrjk:SUPABASE_PASSWORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require

WITH data only, truncate, disable triggers, reset sequences,
     workers = 4, concurrency = 1

CAST type datetime to timestamptz drop default drop not null using zero-dates-to-null,
     type date drop not null drop default using zero-dates-to-null,
     type tinyint to smallint drop typemod

INCLUDING ONLY TABLE NAMES MATCHING
     'users', 'password_reset_tokens', 'failed_jobs', 'personal_access_tokens',
     'categories', 'suppliers', 'products', 'product_attributes', 'stock_transactions',
     'customers', 'wishlists', 'carts', 'orders', 'order_items', 'reviews', 'notifications'

BEFORE LOAD DO
  $$ CREATE SCHEMA IF NOT EXISTS public; $$;
